#!/bin/sh

/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev

/bin/busybox --install -s /bin

echo "==========================================" > /dev/kmsg
echo "  PURE LINUX BOOTED ON REDMI 9A! (PID 1)  " > /dev/kmsg
echo "==========================================" > /dev/kmsg

mkdir -p /sys/kernel/config/usb_gadget/g1
cd /sys/kernel/config/usb_gadget/g1 || exit 1
echo 0x18d1 > idVendor
echo 0x4ee7 > idProduct
mkdir -p strings/0x409
echo "0123456789" > strings/0x409/serialnumber
echo "DandelionLinux" > strings/0x409/manufacturer
echo "PureLinux-USB" > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "RNDIS" > configs/c.1/strings/0x409/configuration
mkdir -p functions/rndis.usb0
ln -s functions/rndis.usb0 configs/c.1/

UDC_DEV=$(ls /sys/class/udc 2>/dev/null | head -n 1)
if [ -n "$UDC_DEV" ]; then
    echo "$UDC_DEV" > UDC
fi

sleep 1
ifconfig lo 127.0.0.1 up
ifconfig usb0 192.168.7.2 netmask 255.255.255.0 up
telnetd -l /bin/sh -p 23 &

while true; do
    setsid cttyhack /bin/sh
    sleep 1
done
